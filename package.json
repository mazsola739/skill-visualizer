{
  "name": "skill-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a JSON skill list into a PlantUML mind map with star ratings.",
  "homepage": "https://mazsola739.github.io/Skill-visualizer/",
  "scripts": {
